-- Binds a replacement body to its original environment and mutable upvalue cells.
-- Called only during installation. Upvalue names must match the original; do not rename them
-- casually.

function bind_body(original, body, source_name)
    if type(debug.upvaluejoin) ~= 'function' then
        return nil, 'shared upvalue API unavailable'
    end
    local names, slots = {}, {}
    for i = 1, 100 do
        local n = debug.getupvalue(original, i)
        if not n then
            break
        end
        if not n:match('^[%a_][%w_]*$') then
            return nil, 'unknown upvalue name'
        end
        names[#names + 1] = n
        slots[n] = i
    end
    local prefix = #names > 0 and ('local ' .. table.concat(names, ',') .. '\n') or ''
    local chunk, err =
        loadstring(prefix .. 'return ' .. body, source_name or '@sloptimizer_function_binding.script')
    if not chunk then
        return nil, err
    end
    local fn = chunk()
    setfenv(fn, getfenv(original))
    for i = 1, 100 do
        local n = debug.getupvalue(fn, i)
        if not n then
            break
        end
        if not slots[n] then
            return nil, 'unexpected replacement upvalue ' .. n
        end
        debug.upvaluejoin(fn, i, original, slots[n])
    end
    return fn
end

-- Fail-closed executable compatibility check, including nested callback prototypes.
function same_implementation(a, b)
    local ok, util = pcall(require, 'jit.util')
    if not ok then return false end
    local ai, bi = util.funcinfo(a), util.funcinfo(b)
    for _, key in ipairs({'bytecodes','gcconsts','nconsts','upvalues','params','isvararg','stackslots'}) do
        if ai[key] ~= bi[key] then return false, key .. ': ' .. tostring(ai[key]) .. '/' .. tostring(bi[key]) end
    end
    if not ai.bytecodes then return false end
    -- Entry opcode can change when JIT compilation occurs; the body must match.
    for i = 1, ai.bytecodes - 1 do
        if util.funcbc(a, i) ~= util.funcbc(b, i) then return false, 'instruction ' .. i .. ': ' .. tostring(util.funcbc(a,i)) .. '/' .. tostring(util.funcbc(b,i)) end
    end
    for i = 0, ai.nconsts - 1 do
        if util.funck(a, i) ~= util.funck(b, i) then return false, 'numeric constant ' .. i end
    end
    for i = 1, ai.gcconsts do
        local av, bv = util.funck(a, -i), util.funck(b, -i)
        if type(av) ~= type(bv) then return false end
        if type(av) == 'string' then
            if av ~= bv then return false, 'string constant ' .. i end
        else
            -- Nested callback prototypes must match too. Unsupported constant types
            -- fail through the caller's protected comparison rather than being accepted.
            if not same_implementation(av, bv) then return false end
        end
    end
    for i = 0, ai.upvalues - 1 do
        if util.funcuvname(a, i) ~= util.funcuvname(b, i) then return false, 'upvalue ' .. i end
    end
    return true
end

