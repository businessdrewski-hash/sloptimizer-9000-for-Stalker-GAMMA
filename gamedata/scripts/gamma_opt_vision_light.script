-- Share world-light brightness within an engine frame, not NPC visibility results.
local installed = false
function make_cache(original, get_frame)
    local last, value
    return function(...)
        local frame = get_frame()
        if frame == nil then return original(...) end
        if frame ~= last then
            value = original(...)
            last = frame
        end
        return value
    end
end
function start()
    if installed then return true, 'already active' end
    local mod = visual_memory_manager
    local fn = mod and mod.lights_lum
    local d = type(fn) == 'function' and debug.getinfo(fn, 'S')
    if not d or not d.source:match('visual_memory_manager%.script$')
        or d.linedefined ~= 204 or d.lastlinedefined ~= 211 then
        return false, 'world light helper differs'
    end
    local dev = device()
    if type(dev.frame) ~= 'number' then return false, 'frame counter unavailable' end
    mod.lights_lum = make_cache(fn, function() return dev.frame end)
    installed = true
    return true, 'world-light brightness once per frame; NPC visibility calculations remain live'
end
