-- Dispatches callbacks using a cached initial heap and depth-local work buffers.
-- Registry additions/removals/priority changes rebuild the template. Ambiguous ordering falls back.

-- Callback dispatch: cached ordering and reusable traversal buffers.

local installed = false

local reviewed = {
dispatch = [====[
function(name,...)
	if (intercepts[name]) then
		for func_or_userdata, v in spairs(intercepts[name], sort_func_values_ascend) do 
			if (type(func_or_userdata) == "function") then 
				func_or_userdata(...)
			elseif (func_or_userdata[name]) then
				func_or_userdata[name](func_or_userdata,...)
			end
		end
	else
		printf("![axr_main make_callback] can't make callback to non existing intercept %s!",name)
		callstack()
	end
end
]====],
spairs = [====[
function(t, order)
	if order and order ~= sort_func_keys_ascend then
		return hspairs(t, order)
	else
		return mspairs_default(t)
	end
end
]====],
order = [====[
function(t, a, b)
	return t[a] < t[b]
end
]====],
heap = [====[
function(t, order)
    -- collect the keys
    local n = 0
    local keys = {}
    for k in pairs(t) do
    	n = n + 1
        keys[n] = k
    end

    -- Return if table is empty
    if n == 0 then
    	return nil_func
    end

    -- If there is only one item, very simple iterator that returns the first item
    if n == 1 then
        local done = false
        return function()
            if done then return nil end
            done = true
            local val = t[keys[1]]
            -- Safety check in case the single item was deleted
            if val ~= nil then 
                return keys[1], val 
            end
        end
    end

    -- Use order if its provided
    if order then
    	order = safe_order(order)
    end
    local sift_down = order and sift_down_order or sift_down_default

    -- Build the Heap: O(N)
    for i = math_floor(n / 2), 1, -1 do
        sift_down(keys, i, n, t, order)
    end

    -- return the iterator function
    return function()
    	while n > 0 do
	        local best_key = keys[1]
            local val = t[best_key]

            keys[1] = keys[n]
            keys[n] = nil
            n = n - 1
	        
	        if n > 0 then
	            sift_down(keys, 1, n, t, order)
	        end
	        
	        if val ~= nil then
                return best_key, val
            end
	    end
	    return nil
    end
end
]====],
sift = [====[
function(keys, idx, end_idx, t, order)
    local hole_idx = idx
    local sifting_key = keys[hole_idx]
    local half_idx = math_floor(end_idx / 2)
    
    while hole_idx <= half_idx do
        local child = hole_idx * 2
        local right = child + 1
        
        if child < end_idx and order(t, keys[right], keys[child]) then
            child = right
        end
        
        if order(t, keys[child], sifting_key) then
            keys[hole_idx] = keys[child]
            hole_idx = child
        else
            break
        end
    end
    keys[hole_idx] = sifting_key
end
]====],
safe = [====[
function(order)
	return function(t, a, b)
		local va = t[a]
	    local vb = t[b]
	    if va == nil then return false end -- 'a' is nil, so 'b' is "better"
	    if vb == nil then return true end  -- 'b' is nil, so 'a' is "better"
	    return order(t, a, b)
	end
end
]====],
}

local function upvalue(fn, wanted)
    for i = 1, 100 do
        local name, value = debug.getupvalue(fn, i)
        if not name then
            break
        end
        if name == wanted then
            return value
        end
    end
end
local function source_is(fn, suffix, first, last)
    if type(fn) ~= 'function' then
        return false
    end
    local d = debug.getinfo(fn, 'S')
    return d and d.source:sub(-#suffix) == suffix and d.linedefined == first and d.lastlinedefined == last
end
local function sift(keys, index, n, t)
    local key = keys[index]
    -- No callbacks run inside a sift; priorities remain live between sifts.
    local priority = t[key]
    while index * 2 <= n do
        local child = index * 2
        local child_priority = t[keys[child]]
        if child < n then
            local right_priority = t[keys[child + 1]]
            if right_priority ~= nil and (child_priority == nil or right_priority < child_priority) then
                child = child + 1
                child_priority = right_priority
            end
        end
        if child_priority ~= nil and (priority == nil or child_priority < priority) then
            keys[index] = keys[child]
            index = child
        else
            break
        end
    end
    keys[index] = key
end

function make_dispatch(original, registry)
    local caches, frames = setmetatable({}, { __mode = 'k' }), {}
    local depth = 0
    local function template(t)
        local c = caches[t]
        local n, changed = 0, not c
        for key, value in pairs(t) do
            n = n + 1
            if type(value) ~= 'number' or value ~= value then
                return
            end
            if c and c.values[key] ~= value then
                changed = true
            end
        end
        if c and n ~= c.n then
            changed = true
        end
        if not changed then
            return c
        end
        -- Registration changes are uncommon. Rebuild only at those boundaries.
        c = { n = n, keys = {}, values = {} }
        local unique = {}
        local i = 0
        for key, value in pairs(t) do
            if unique[value] then
                return
            end -- equal-priority ordering not assumed
            unique[value] = true
            i = i + 1
            c.keys[i] = key
            c.values[key] = value
        end
        for j = math.floor(n / 2), 1, -1 do
            sift(c.keys, j, n, t)
        end
        caches[t] = c
        return c
    end
    local function dispatch(name, ...)
        local t = registry[name]
        if not t or getmetatable(t) then
            return original(name, ...)
        end
        local c = template(t)
        if not c then
            return original(name, ...)
        end
        if c.n == 0 then
            return
        end
        if c.n == 1 then
            local key = c.keys[1]
            if type(key) == 'function' then
                key(...)
            elseif key[name] then
                key[name](key, ...)
            end
            return
        end
        local keys = frames[depth]
        if not keys then
            keys = {}
            frames[depth] = keys
        end
        local n = c.n
        for i = 1, n do
            keys[i] = c.keys[i]
        end
        while n > 0 do
            local key = keys[1]
            local value = t[key]
            keys[1] = keys[n]
            keys[n] = nil
            n = n - 1
            if n > 0 then
                sift(keys, 1, n, t)
            end
            if value ~= nil then
                if type(key) == 'function' then
                    key(...)
                elseif key[name] then
                    key[name](key, ...)
                end
            end
        end
    end
    return function(name, ...)
        depth = depth + 1
        local ok, err = pcall(dispatch, name, ...)
        if not ok and frames[depth] then
            for i = #frames[depth], 1, -1 do
                frames[depth][i] = nil
            end
        end
        depth = depth - 1
        if not ok then
            error(err, 0)
        end
    end
end

-- Installation: validate the upstream implementation before changing it.
function install()
    if installed then
        return true, 'already active'
    end
    local original = axr_main.make_callback
    if
        not source_is(original, 'axr_main.script', 280, 293)
        or not source_is(spairs, '_g_patches.script', 1060, 1066)
        or not source_is(sort_func_values_ascend, '_g_patches.script', 413, 415)
    then
        return false, 'dispatcher or sort implementation differs from reviewed build'
    end
    local env = getfenv(original)
    local ordered = env.spairs
    local heap = type(ordered) == 'function' and getfenv(ordered).hspairs
    local matches = sloptimizer_function_binding.matches_body
    if not matches(original, reviewed.dispatch)
        or not matches(ordered, reviewed.spairs)
        or not matches(env.sort_func_values_ascend, reviewed.order)
        or not matches(heap, reviewed.heap)
        or not matches(upvalue(heap, 'sift_down_order'), reviewed.sift)
        or not matches(upvalue(heap, 'safe_order'), reviewed.safe)
        or upvalue(heap, 'math_floor') ~= math.floor then
        return false, 'unrecognized callback/sort body; original retained'
    end
    local registry = upvalue(original, 'intercepts')
    if type(registry) ~= 'table' then
        return false, 'callback registry unavailable'
    end
    local optimized = make_dispatch(original, registry)
    local order = env.sort_func_values_ascend
    local sort_env = getfenv(ordered)
    axr_main.make_callback = function(name, ...)
        -- A later mod may replace the public sorting functions. Respect its
        -- semantics through the original dispatcher instead of bypassing them.
        if env.spairs ~= ordered or env.sort_func_values_ascend ~= order
            or sort_env.hspairs ~= heap then
            return original(name, ...)
        end
        return optimized(name, ...)
    end
    installed = true
    return true, 'initial-heap cache and reusable traversal buffers active'
end
