-- Component startup and activation status.

local started = false
local first
local results = {}
local function add(name, ok, detail)
    results[#results + 1] = name .. ': ' .. (ok and 'ACTIVE' or 'SKIPPED') .. ' - ' .. tostring(detail)
end
function start()
    if started then
        return results
    end
    started = true
    local cfg = gamma_opt_config
    if cfg.shared_clock then
        local ok, detail = gamma_opt_clock.start()
        add('shared clock', ok, detail)
    end
    if cfg.markers then
        local util = utils_catspaw_hudmarks
        local d = util
            and type(util.marker_is_offscreen) == 'function'
            and debug.getinfo(util.marker_is_offscreen, 'S')
        if d and d.source:match('utils_catspaw_hudmarks%.script$') and d.linedefined == 1738 then
            local ok, err = pcall(gamma_opt_markers.start)
            add('markers', ok, ok and 'smooth projection / scheduled semantic checks' or err)
        else
            add('markers', false, 'marker implementation differs or another override is active')
        end
    end
    if cfg.injury_display then
        local ok, detail = gamma_opt_injury.start(cfg.injury_display_interval_ms)
        add('injury display', ok, detail)
    end
    if cfg.ledge_ray_reuse then
        local ok, detail = gamma_opt_ledge.start()
        add('ledge rays', ok, detail)
    end
    if cfg.callback_cache then
        local ok, detail = gamma_opt_callbacks.start()
        add('callback cache', ok, detail)
    end
    if cfg.ray_query_inputs then
        local ok, detail = gamma_opt_ray_query.start()
        add('ray query inputs', ok, detail)
    end
    if cfg.light_scan_cache then
        local ok, detail = gamma_opt_environment.start_lights(cfg.light_scan_interval_ms)
        add('light scans', ok, detail)
    end
    if cfg.offline_peer_panel then
        local ok, detail = gamma_opt_environment.start_peers()
        add('offline peer panel', ok, detail)
    end
    if cfg.peer_field_cache then
        local ok, detail = gamma_opt_peer_fields.start()
        add('peer field cache', ok, detail)
    end
    if cfg.artifact_kind_cache then
        local ok, detail = gamma_opt_items.start()
        add('artifact metadata', ok, detail)
    end
    if cfg.v2_item_updates then
        local ok, d = gamma_opt_item_v2.start()
        add('V2 item update', ok, d)
    end
    if cfg.v2_artifact_updates then
        local ok, d = gamma_opt_artifact_v2.start()
        add('V2 artifact update', ok, d)
    end
    if cfg.v2_projection then
        local ok, d = gamma_opt_projection_v2.start()
        add('V2 projection', ok, d)
    end
    if cfg.v2_radiation then
        local ok, d = gamma_opt_radiation_v2.start()
        add('V2 radiation', ok, d)
    end
    if cfg.v2_task_checks then
        local ok, d = gamma_opt_tasks_v2.start()
        add('V2 task checks', ok, d)
    end
    if cfg.vision_light_frame then
        local ok, detail = gamma_opt_vision_light.start()
        add('vision world light', ok, detail)
    end
    if cfg.native_read_reduction then
        local ok, detail = gamma_opt_native_reads.start()
        add('native read reduction', ok, detail)
    end
    if cfg.lamp_save_buffers then
        local ok, detail = gamma_opt_churn.start_lamp_buffers()
        add('lamp save buffers', ok, detail)
    end
    local root = getFS():update_path('$app_data_root$', 'logs\\')
    local f = io.open(root .. 'gamma-optimization-status.txt', 'w')
    if f then
        f:write('Experimental optimization preview\n', table.concat(results, '\n'), '\n')
        f:close()
    end
    for _, line in ipairs(results) do
        printf('[Gamma Optimization Preview] %s', line)
    end
    return results
end
function actor_on_update()
    if started then
        return
    end
    first = first or time_global()
    if time_global() - first < 5000 then
        return
    end
    if not db.actor then
        return
    end
    local dot = ui_hud_dotmarks
    if gamma_opt_config.markers and (not dot or not dot.scanning or not next(dot.cfg.markers)) then
        return
    end
    start()
end
function on_game_start()
    RegisterScriptCallback('actor_on_update', actor_on_update)
end
