-- Runs the original nearby-object scan on every call. No TTL or shared result cache.
-- Reuses only the synchronous visit closure; class membership and alive state stay live.
local installed = false
local reference_body = [====[
function(lamp_obj)
	
	-- Flicker on Emission Wave or Vortex
	if (level_environment.get_light_flicker()) then return true end
	
	-- Flicker if Psi Mutant nearby
	local psi_influence = false
	local function iterate_func(obj)
		if (obj and psi_influence_clsid[obj:clsid()] and obj:alive()) then 
			psi_influence = true
			return true
		end
	end

	level.iterate_nearest(lamp_obj:position(), 15, iterate_func)
	
	if psi_influence then return true end
	
	return switch
end
]====]

function make_live_scan(original, get_kinds, get_switch)
    local active, found = false, false
    local function visit(obj)
        if obj and get_kinds()[obj:clsid()] and obj:alive() then
            found = true
            return true
        end
    end
    local function scan(lamp)
        level.iterate_nearest(lamp:position(), 15, visit)
    end
    return function(lamp)
        if active then return original(lamp) end
        if level_environment.get_light_flicker() then return true end
        active, found = true, false
        local ok, err = pcall(scan, lamp)
        active = false
        if not ok then error(err, 0) end
        if found then return true end
        return get_switch()
    end
end

function install()
    if installed then return true, 'already active' end
    local mod = bind_light_furniture
    local original = mod and mod.need_flicker
    local info = type(original) == 'function' and debug.getinfo(original, 'S')
    if not info or not info.source:match('bind_light_furniture%.script$') or info.linedefined ~= 33 or info.lastlinedefined ~= 52 then
        return false, 'light flicker implementation differs'
    end
    local probe = sloptimizer_function_binding.bind_body(original, reference_body)
    local ok, matches = pcall(sloptimizer_function_binding.same_implementation, original, probe)
    if not probe or not ok or not matches then return false, 'unrecognized light scan body; original retained' end
    local kinds, kinds_slot, switch_slot
    for i = 1, 32 do
        local name, value = debug.getupvalue(original, i)
        if not name then break end
        if name == 'psi_influence_clsid' and type(value) == 'table' then kinds = value; kinds_slot = i end
        if name == 'switch' then switch_slot = i end
    end
    if not kinds or not switch_slot then return false, 'light scan state unavailable' end
    local function switch_value()
        local _, value = debug.getupvalue(original, switch_slot)
        return value
    end
    local function kind_values()
        local _, value = debug.getupvalue(original, kinds_slot)
        return value
    end
    mod.need_flicker = make_live_scan(original, kind_values, switch_value)
    installed = true
    return true, 'live scan on every call; reusable visit callback; no cached lighting results'
end
