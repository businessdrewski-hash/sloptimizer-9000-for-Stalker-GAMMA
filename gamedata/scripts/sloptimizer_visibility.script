local function atmosphere(body)
    body = body:gsub('/ 3%.02', '/ 2.35')
    body = body:gsub('lumin_r2 %* 2', 'lumin_r2 * 4')
    return body
end

function matching_body(original)
    local reasons = {}
    -- xrRazom's reviewed load-time rewrite changes the inner body as well as
    -- wrapping it. Preserve its per-target memory/marking and live peer-count gate.
    local function peer_bookkeeping(body)
        body = body:gsub('vision_memory%[npc:id%(%)%] = {}', 'vision_memory[npc:id()] = XrrPeerCount > 0 and vision_memory[npc:id()] or {}')
        body = body:gsub('if marked%[npc:id%(%)%] then', 'if marked[XrrPeerCount > 0 and (npc:id() * 65536 + who:id()) or npc:id()] then')
        body = body:gsub('local memory_factor = 0', 'local memory_factor = 0 if XrrPeerCount > 0 then actor_marked = 0 end')
        return body
    end
    for _, variant in ipairs({'Stealth Crash Fix', 'Atmospherics', 'Stealth Crash Fix + xrRazom', 'Atmospherics + xrRazom'}) do
        local reference, selected = reference_body, replacement_body
        if variant:find('Atmospherics', 1, true) then reference, selected = atmosphere(reference), atmosphere(selected) end
        if variant:find('xrRazom', 1, true) then reference, selected = peer_bookkeeping(reference), peer_bookkeeping(selected) end
        local probe = sloptimizer_function_binding.bind_body(original, reference)
        if probe then
            local ok, matches, detail = pcall(sloptimizer_function_binding.same_implementation, original, probe)
            if ok and matches then
                return selected, variant
            end
            reasons[#reasons + 1] = variant .. ': ' .. tostring(ok and detail or matches)
        end
    end
    return nil, 'unrecognized visibility instructions/constants; original retained (' .. table.concat(reasons, '; ') .. ')'
end

-- Installation: validate the upstream implementation before changing it.
function install()
    if installed then
        return true, 'already active'
    end
    local original = visual_memory_manager and visual_memory_manager.get_visible_value
    local multiplayer_wrapper, original_slot = original, nil
    local outer_info = type(original) == 'function' and debug.getinfo(original, 'S')
    if
        outer_info
        and outer_info.source:match('xrr_patch_stealth%.script$')
        and outer_info.linedefined == 19
    then
        for i = 1, 100 do
            local n, value = debug.getupvalue(original, i)
            if not n then
                break
            end
            if n == 'orig' and type(value) == 'function' then
                original_slot = i
                original = value
                break
            end
        end
    end
    local source_info = type(original) == 'function' and debug.getinfo(original, 'S')
    if
        not source_info
        or not source_info.source:match('visual_memory_manager%.script$')
        or source_info.linedefined ~= 28
    then
        return false, 'visibility implementation differs'
    end
    local selected_body, variant = matching_body(original)
    if not selected_body then return false, variant end
    local replacement, error_message =
        sloptimizer_function_binding.bind_body(original, selected_body, '@sloptimizer_visibility.script')
    if not replacement then
        return false, tostring(error_message)
    end
    if original_slot then
        debug.setupvalue(multiplayer_wrapper, original_slot, replacement)
    else
        visual_memory_manager.get_visible_value = replacement
    end
    installed = true
    return true, 'conditional flashlight lookups; verified ' .. variant .. ' formulas preserved'
end

function replacement_source()
    return replacement_body
end
