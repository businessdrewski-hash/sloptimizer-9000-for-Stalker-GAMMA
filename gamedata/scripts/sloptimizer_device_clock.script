-- Creates a live clock accessor using a retained device handle when available.
-- Fallback is the existing time_global function. No time values are cached.

function make_clock()
    local d = type(device) == 'function' and device() or nil
    if d and type(d.time_global) == 'function' then
        return function()
            return d:time_global()
        end
    end
    return time_global
end
