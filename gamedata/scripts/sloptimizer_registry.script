-- Installation order and component contracts.
-- Ledge rays precede callback dispatch; metadata precedes artifact updates;
-- party-session polling is installed before the party-field replacement.
function entries()
    return {
        {
            id = 'shared_clock',
            switch = 'shared_clock',
            label = 'Shared clock',
            module = 'sloptimizer_live_clock',
            method = 'install',
            dependencies = {},
            argument = nil,
            targets = { '_G.time_global' },
        },
        {
            id = 'markers',
            switch = 'markers',
            label = 'Markers',
            module = 'sloptimizer_marker_updates',
            method = 'install',
            dependencies = { 'utils_catspaw_hudmarks', 'ui_hud_dotmarks' },
            argument = nil,
            targets = {
                'utils_catspaw_hudmarks.marker_is_offscreen',
                'utils_catspaw_hudmarks.dotproduct_for_pos',
            },
        },
        {
            id = 'injury_display',
            switch = 'injury_display',
            label = 'Injury display',
            module = 'sloptimizer_body_health_display',
            method = 'install',
            dependencies = { 'zzz_player_injuries' },
            argument = 'injury_display_interval_ms',
            targets = { 'zzz_player_injuries.actor_on_update::HUDUpdate' },
        },
        {
            id = 'ledge_rays',
            switch = 'ledge_ray_reuse',
            label = 'Ledge rays',
            module = 'sloptimizer_ledge_rays',
            method = 'install',
            dependencies = { 'demonized_ledge_grabbing', 'demonized_geometry_ray', 'axr_main' },
            argument = nil,
            targets = {
                'demonized_ledge_grabbing.checkLedgeGrabbing',
                'demonized_ledge_grabbing.checkLedgeGrabbing::dgr',
            },
        },
        {
            id = 'callback_cache',
            switch = 'callback_cache',
            label = 'Callback cache',
            module = 'sloptimizer_callback_dispatch',
            method = 'install',
            dependencies = { 'axr_main' },
            argument = nil,
            targets = { 'axr_main.make_callback' },
        },
        {
            id = 'ray_query_inputs',
            switch = 'ray_query_inputs',
            label = 'Ray query inputs',
            module = 'sloptimizer_ray_queries',
            method = 'install',
            dependencies = { 'demonized_geometry_ray' },
            argument = nil,
            targets = { 'demonized_geometry_ray.geometry_ray.get' },
        },
        {
            id = 'light_scans',
            switch = 'light_scan_cache',
            label = 'Light scans',
            module = 'sloptimizer_light_flicker',
            method = 'install',
            dependencies = { 'bind_light_furniture' },
            argument = nil,
            targets = { 'bind_light_furniture.need_flicker' },
        },
        {
            id = 'offline_peer_panel',
            switch = 'offline_peer_panel',
            label = 'Offline peer panel',
            module = 'sloptimizer_party_session',
            method = 'install',
            dependencies = { 'xrr_peer_hud' },
            argument = nil,
            targets = { 'xrr_peer_hud.UIPeerList.Update' },
        },
        {
            id = 'peer_field_cache',
            switch = 'peer_field_cache',
            label = 'Peer field cache',
            module = 'sloptimizer_party_fields',
            method = 'install',
            dependencies = { 'xrr_peer_hud' },
            argument = nil,
            targets = { 'xrr_peer_hud.UIPeerList.Update' },
        },
        {
            id = 'artifact_metadata',
            switch = 'artifact_kind_cache',
            label = 'Artifact metadata',
            module = 'sloptimizer_artifact_metadata',
            method = 'install',
            dependencies = { 'item_artefact' },
            argument = nil,
            targets = { 'zz_item_artefact.SYS_GetParam' },
        },
        {
            id = 'item_update',
            switch = 'item_updates',
            label = 'Item update',
            module = 'sloptimizer_item_updates',
            method = 'install',
            dependencies = { 'bind_item' },
            argument = nil,
            targets = { 'bind_item.item_binder.update' },
        },
        {
            id = 'artifact_update',
            switch = 'artifact_updates',
            label = 'Artifact update',
            module = 'sloptimizer_artifact_updates',
            method = 'install',
            dependencies = { 'item_artefact' },
            argument = nil,
            targets = { 'item_artefact.artefact_binder.update' },
        },
        {
            id = 'projection',
            switch = 'marker_projection',
            label = 'Projection',
            module = 'sloptimizer_marker_projection',
            method = 'install',
            dependencies = { 'utils_catspaw_hudmarks', 'ui_hud_dotmarks' },
            argument = nil,
            targets = { 'utils_catspaw_hudmarks.world_to_ui', 'ui_hud_dotmarks.dot_eye' },
        },
        {
            id = 'radiation',
            switch = 'radiation_display',
            label = 'Radiation',
            module = 'sloptimizer_radiation_display',
            method = 'install',
            dependencies = { 'actor_status' },
            argument = nil,
            targets = { 'actor_status.UIIndicators.Update' },
        },
        {
            id = 'task_checks',
            switch = 'task_checks',
            label = 'Task checks',
            module = 'sloptimizer_task_checks',
            method = 'install',
            dependencies = { 'task_manager' },
            argument = nil,
            targets = { 'task_manager.CRandomTask.task_complete', 'task_manager.CRandomTask.task_fail' },
        },
        {
            id = 'vision_world_light',
            switch = 'vision_light_frame',
            label = 'Vision world light',
            module = 'sloptimizer_world_lighting',
            method = 'install',
            dependencies = { 'visual_memory_manager' },
            argument = nil,
            targets = { 'visual_memory_manager.lights_lum' },
        },
        {
            id = 'visibility_read_reduction',
            switch = 'visibility_reads',
            label = 'Visibility read reduction',
            module = 'sloptimizer_visibility',
            method = 'install',
            dependencies = { 'visual_memory_manager', 'stealth_mcm', 'camp_lum', 'level_weathers' },
            argument = nil,
            targets = {
                'visual_memory_manager.get_visible_value',
                'visual_memory_manager.get_visible_value::orig',
            },
        },
        {
            id = 'device_read_reduction',
            switch = 'device_updates',
            label = 'Device read reduction',
            module = 'sloptimizer_device_updates',
            method = 'install',
            dependencies = { 'item_device' },
            argument = nil,
            targets = { 'item_device.device_binder.update' },
        },
        {
            id = 'lamp_save_buffers',
            switch = 'lamp_save_buffers',
            label = 'Lamp save buffers',
            module = 'sloptimizer_lamp_save_buffers',
            method = 'install',
            dependencies = { 'bind_light_furniture', 'hf_obj_manager' },
            argument = nil,
            targets = { 'bind_light_furniture.placeable_light_wrapper.save_data' },
        },
    }
end
