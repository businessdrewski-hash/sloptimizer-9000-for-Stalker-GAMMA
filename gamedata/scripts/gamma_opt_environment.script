-- Light scan caching and multiplayer party-panel visibility.

local peer_installed = false
local light_installed = false
-- Reuse the synchronous scan callback and immutable object classification.
-- Weak keys do not retain nearby objects. Alive/position/emission stay live.
function make_psi_scan(original, kinds, get_switch)
    local classes = setmetatable({}, { __mode = 'k' })
    local active, found = false, false
    local function visit(obj)
        if found then
            return true
        end -- No remaining classification can change a positive scan.
        if not obj then
            return
        end
        local psi = classes[obj]
        if psi == nil then
            psi = not not kinds[obj:clsid()]
            classes[obj] = psi
        end
        if psi and obj:alive() then
            found = true
            return true
        end
    end
    return function(lamp)
        if active then
            return original(lamp)
        end
        if level_environment.get_light_flicker() then
            return true
        end
        if get_switch() == true then
            return true
        end -- Result is already guaranteed.
        local pos = lamp:position()
        active = true
        found = false
        local ok, err = pcall(level.iterate_nearest, pos, 15, visit)
        active = false
        if not ok then
            error(err, 0)
        end
        return found or get_switch()
    end
end
local function scan_adapter(fn, interval)
    local kinds, switch_index
    for i = 1, 32 do
        local name, value = debug.getupvalue(fn, i)
        if not name then
            break
        end
        if name == 'psi_influence_clsid' and type(value) == 'table' then
            kinds = value
        end
        if name == 'switch' then
            switch_index = i
        end
    end
    if not kinds or not switch_index then
        return fn
    end
    local get_switch = function()
        local _, v = debug.getupvalue(fn, switch_index)
        return v
    end
    local fallback = make_psi_scan(fn, kinds, get_switch)
    if
        gamma_opt_config
        and gamma_opt_config.shared_light_scan
        and level
        and type(level.iterate_nearest) == 'function'
    then
        local d = device()
        local nearest = type(level.nearest_object) == 'function' and level.nearest_object or nil
        return gamma_opt_light_shared.make_scan(
            fallback,
            kinds,
            get_switch,
            function()
                return d:time_global()
            end,
            interval,
            {
                nearest = nearest,
                anypsi = gamma_opt_light_shared.make_presence_query(kinds, level.iterate_nearest),
                vector = vector,
                emission = level_environment.get_light_flicker,
            }
        ),
            nearest and 'native class query' or 'shared nearby iterator'
    end
    return fallback, false
end
local function make_clock()
    local d = type(device) == 'function' and device() or nil
    if d and type(d.time_global) == 'function' then
        return function()
            return d:time_global()
        end
    end
    return time_global
end
function make_light_cache(original, interval)
    local cache = setmetatable({}, { __mode = 'k' })
    local clock = make_clock()
    return function(obj)
        -- Emission/vortex changes are not delayed by the cache.
        if level_environment.get_light_flicker() then
            return true
        end
        local now = clock()
        local c = cache[obj]
        if c and now >= c.time and now < c.expires then
            return c.value
        end
        local value, expires = original(obj)
        if not c then
            c = {}
            cache[obj] = c
        end
        c.time = now
        c.value = value
        c.expires = math.min(now + interval, expires or (now + interval))
        return value
    end
end
function start_lights(interval)
    if light_installed then
        return true, 'already active'
    end
    local mod = bind_light_furniture
    local fn = mod and mod.need_flicker
    local d = type(fn) == 'function' and debug.getinfo(fn, 'S')
    if
        not d
        or not d.source:match('bind_light_furniture%.script$')
        or d.linedefined ~= 33
        or d.lastlinedefined ~= 52
    then
        return false, 'light flicker implementation differs from reviewed build'
    end
    interval = math.max(1, math.min(250, tonumber(interval) or 100))
    local scan, shared = scan_adapter(fn, interval)
    mod.need_flicker = make_light_cache(scan, interval)
    light_installed = true
    return true,
        'flicker cache '
            .. interval
            .. ' ms; '
            .. (
                shared and (shared .. ' armed with shadow validation')
                or 'shared scan disabled; prior scan retained'
            )
end

function make_peer_poller(mod)
    local hidden, last, last_hud
    local clock = make_clock()
    return function()
        local now = clock()
        if last and now >= last and now - last < 500 then
            return
        end
        last = now
        local current = mod.HUD
        if hidden and current ~= hidden then
            hidden = nil
        end
        if not current then
            last_hud = nil
            return
        end
        local in_session = XrrIsHosted() or XrrIsConnected()
        if in_session then
            if hidden == current then
                get_hud():AddDialogToRender(current)
                hidden = nil
                current:Update(true)
            end
        elseif hidden ~= current then
            -- Original forced update hides slots and restores companion placement.
            current:Update(true)
            get_hud():RemoveDialogToRender(current)
            hidden = current
        end
        last_hud = current
    end
end
function start_peers()
    if
        type(rawget(_G, 'XrrIsHosted')) ~= 'function'
        or type(rawget(_G, 'XrrIsConnected')) ~= 'function'
        or type(rawget(_G, 'XrrPlayers')) ~= 'function'
    then
        return false, 'xrRazom engine not present; multiplayer-only feature skipped'
    end

    if peer_installed then
        return true, 'already active'
    end
    local mod = xrr_peer_hud
    if not mod or not mod.UIPeerList then
        return false, 'peer HUD not present'
    end
    local fn = mod.UIPeerList.Update
    local d = type(fn) == 'function' and debug.getinfo(fn, 'S')
    if not d or not d.source:match('xrr_peer_hud%.script$') or d.linedefined ~= 174 then
        return false, 'peer HUD implementation differs from reviewed build'
    end
    RegisterScriptCallback('actor_on_update', make_peer_poller(mod))
    peer_installed = true
    return true, 'offline peer panel removed from render updates; session changes polled every 500 ms'
end
